PORT=5050

# Database Connection String
# For Local SQLite:
DATABASE_URL="file:./dev.db"
# For Neon PostgreSQL (Production Deployment):
# DATABASE_URL="postgresql://<user>:<password>@<neon-hostname>.neon.tech/neondb?sslmode=require"

JWT_SECRET="replace_with_a_secure_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# Razorpay API Credentials (from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_placeholder123"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder456"

# Frontend Origin for CORS (e.g. https://your-app.vercel.app or http://localhost:5173)
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
